# ===================================================================
# Faculty Feedback Management System - Environment Configuration
# ===================================================================
# Copy this file to '.env' for local development and fill in your values.
# NEVER commit your actual '.env' file to version control.
# ===================================================================

# -------------------------------------------------------------------
# 1. MongoDB Database Connection (MongoDB Atlas or Local)
# -------------------------------------------------------------------
# Render/Production: Use your MongoDB Atlas connection string with your secure user/password.
# Local development: mongodb://127.0.0.1:27017/knit-feedback
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/knit-feedback?retryWrites=true&w=majority

# -------------------------------------------------------------------
# 2. JWT Authentication Secrets (Generate with `openssl rand -hex 32`)
# -------------------------------------------------------------------
# Use strong, unique, high-entropy random strings in production.
ACCESS_TOKEN_SECRET=your_long_random_access_token_secret_here_min_32_chars
REFRESH_TOKEN_SECRET=your_long_random_refresh_token_secret_here_min_32_chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# -------------------------------------------------------------------
# 3. Google OAuth 2.0 (Google Workspace / Google Sign-In)
# -------------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# -------------------------------------------------------------------
# 4. Initial System Administrator Credentials
# -------------------------------------------------------------------
# The backend will automatically and securely create the default admin
# account upon initial boot if one does not already exist in the database.
DEFAULT_ADMIN_EMAIL=admin@institute.ac.in
DEFAULT_ADMIN_PASSWORD=YourStrongAdminPasswordHere123!
# Or provide a pre-hashed bcrypt string (cost factor 12):
# DEFAULT_ADMIN_PASSWORD_HASH=$2b$12$...

# -------------------------------------------------------------------
# 5. Server & Environment
# -------------------------------------------------------------------
PORT=5001
NODE_ENV=development

# -------------------------------------------------------------------
# 6. CORS Whitelist Configuration
# -------------------------------------------------------------------
# Comma-separated list of allowed frontend domains.
# Production (Render): Set to your Vercel deployment URL (e.g. https://feedback.yourcollege.ac.in,https://my-app.vercel.app)
# Local: http://localhost:5173
CORS_ORIGIN=http://localhost:5173,https://your-app.vercel.app

# -------------------------------------------------------------------
# 7. Cloudinary (Optional - For College Logo & Asset Uploads)
# -------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -------------------------------------------------------------------
# 8. Frontend Vite Environment Variables (Vercel Frontend Deployment)
# -------------------------------------------------------------------
# Set this in your Vercel dashboard environment variables:
VITE_API_URL=http://localhost:5001/api
